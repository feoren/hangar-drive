    "allow-restore-deleted-folder",
    "allow-cancel-restore",
    "allow-redownload-folder",
    "allow-get-server-number",
    "allow-confirm-server-number",
    "allow-fix-server-with-offer",
    "allow-restore-remote-deleted",
    "allow-install-update",
    "allow-get-settings",
    "allow-set-autostart",
    "allow-set-language",
