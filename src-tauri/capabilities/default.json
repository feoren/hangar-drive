{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the Backend interface of src/backend/types.ts, one command per method (snapshot, setup, pairing, recovery, folders, problems, conflicts, restore, devices, settings, reset, signed updates, tray, window, opened links), and listening to the one event channel hangar-drive://event. No plugin permission: dialogs, clipboard, notifications, autostart and deep links are used by the backend only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-snapshot",
    "allow-read-clipboard-text",
    "allow-check-invite",
    "allow-inspect-link",
    "allow-default-device-name",
    "allow-begin-account",
    "allow-print-recovery-sheet",
    "allow-save-recovery-file",
    "allow-copy-recovery-code",
    "allow-confirm-recovery-group",
    "allow-default-folder-place",
    "allow-pick-folder",
    "allow-count-local-files",
    "allow-finish-setup",
    "allow-scan-with-camera",
    "allow-start-pairing",
    "allow-cancel-pairing",
    "allow-list-account-folders",
    "allow-join-folders",
    "allow-recover-account",
    "allow-set-device-name",
    "allow-recovery-devices",
    "allow-finish-recovery-cleanup",
    "allow-open-folder",
    "allow-pause",
    "allow-resume",
    "allow-sync-now",
    "allow-retry-connection",
    "allow-pause-folder",
    "allow-resume-folder",
    "allow-add-folder",
    "allow-add-account-folder",
    "allow-stop-folder",
    "allow-delete-folder-everywhere",
    "allow-list-not-synced",
    "allow-get-folder-number",
    "allow-list-mass-delete",
    "allow-resolve-mass-delete",
    "allow-find-missing-folder",
    "allow-check-older-state",
    "allow-reanchor",
    "allow-dismiss-suspect",
    "allow-accept-removed-heads",
    "allow-open-storage-settings",
    "allow-copy-error-report",
    "allow-preview-error-report",
    "allow-save-error-report",
    "allow-list-conflicts",
    "allow-open-conflict",
    "allow-keep-conflict-version",
    "allow-keep-both-conflict",
    "allow-list-name-issues",
    "allow-rename-name-issue",
    "allow-ignore-name-issue",
    "allow-get-timeline",
    "allow-get-tree-at",
    "allow-restore-file",
