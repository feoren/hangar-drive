# Secrets and local configuration
.env
.env.*

# Build output and dependencies
node_modules/
dist/
src-tauri/target/
# Build output of the Cargo workspace (app, protocol crate and server).
/target/
release/

# Python tools under tools/
__pycache__/
*.py[cod]

# Agent working copies (git worktree)
.claude/worktrees/

# Local design drafts, not versioned
output/

# Local test files (test data stays inside the project)
tests/.tmp/
src-tauri/tests/.tmp/

# Data folder of a local server run (HANGAR_DRIVE_DATA_DIR defaults to ./data)
/data/
!.env.example
