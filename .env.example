# Copy to .env next to docker-compose.yml and adjust. Never commit .env.

# Address devices reach this server under; every sign-in is bound to it.
# https only (http is allowed for localhost), no path. Required.
HANGAR_DRIVE_PUBLIC_URL=https://drive.example.org/

# Domain for the optional Caddy reverse proxy in docker-compose.yml.
# DRIVE_DOMAIN=drive.example.org
